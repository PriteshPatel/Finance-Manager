// ============= EXPENSE ENDPOINTS =============

// Get all expenses for user
app.get('/expenses', verifyToken, (_req, res) => {
  try {
    const userId = _req.userId;
    const userExpenses = storage.expenses[userId] || [];
    res.json({ expenses: userExpenses });
  } catch (error) {
    console.error('Error fetching expenses:', error);
    res.status(500).json({ error: 'Failed to fetch expenses' });
  }
});

// Create expense
app.post('/expenses', verifyToken, (req, res) => {
  try {
    const userId = req.userId;
    const { amount, category, description, date, recurring, tags } = req.body;
    
    if (!storage.expenses[userId]) {
      storage.expenses[userId] = [];
    }
    
    const expense = {
      id: Date.now().toString(),
      userId,
      amount: parseFloat(amount),
      category,
      description,
      date,
      recurring: recurring || false,
      tags: tags || [],
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
    };
    
    storage.expenses[userId].push(expense);
    res.status(201).json({ expense });
  } catch (error) {
    console.error('Error creating expense:', error);
    res.status(500).json({ error: 'Failed to create expense' });
  }
});

// Update expense
app.put('/expenses/:id', verifyToken, (req, res) => {
  try {
    const userId = req.userId;
    const expenseId = req.params.id;
    const updates = req.body;
    
    if (!storage.expenses[userId]) {
      return res.status(404).json({ error: 'Expense not found' });
    }
    
    const expenseIndex = storage.expenses[userId].findIndex(e => e.id === expenseId);
    if (expenseIndex === -1) {
      return res.status(404).json({ error: 'Expense not found' });
    }
    
    storage.expenses[userId][expenseIndex] = {
      ...storage.expenses[userId][expenseIndex],
      ...updates,
      updatedAt: new Date().toISOString(),
    };
    
    res.json({ expense: storage.expenses[userId][expenseIndex] });
  } catch (error) {
    console.error('Error updating expense:', error);
    res.status(500).json({ error: 'Failed to update expense' });
  }
});

// Delete expense
app.delete('/expenses/:id', verifyToken, (req, res) => {
  try {
    const userId = req.userId;
    const expenseId = req.params.id;
    
    if (!storage.expenses[userId]) {
      return res.status(404).json({ error: 'Expense not found' });
    }
    
    storage.expenses[userId] = storage.expenses[userId].filter(e => e.id !== expenseId);
    res.json({ success: true });
  } catch (error) {
    console.error('Error deleting expense:', error);
    res.status(500).json({ error: 'Failed to delete expense' });
  }
});

